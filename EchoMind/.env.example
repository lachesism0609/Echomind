# ── AI / LLM ──────────────────────────────────────────────────────────────────
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-v4-pro
ANTHROPIC_API_KEY=your_api_key

# ── 存储 ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=echomind123

# ── Skills ───────────────────────────────────────────────────────────────────
ECHOMIND_SKILLS_DIR=./skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000

# ── Blue Orchid 集成（Echomind -> Blue Orchid 内部接口）──────────────────────
BLUE_ORCHID_BASE_URL=http://localhost:3010
BLUE_ORCHID_INTERNAL_TOKEN=replace-with-echomind-service-token
BLUE_ORCHID_TIMEOUT_MS=10000

# ── Echomind 内部接口鉴权（Blue Orchid -> Echomind 时携带的令牌）─────────────
ECHOMIND_API_TOKEN=replace-with-echomind-client-token

# ── CORS 白名单（逗号分隔）───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3010,http://127.0.0.1:3010
